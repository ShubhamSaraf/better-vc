# Usually leave unset: Vite securely proxies /signal to the local signaling server.
# Set only when using a separately hosted signaling endpoint.
# VITE_SIGNAL_URL=wss://signal.example.com
# Comma-separated TURN URLs and credentials (optional on a LAN/localhost)
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
SIGNAL_PORT=8787
